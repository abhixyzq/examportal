# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=super_secret_exam_portal_jwt_token_2026

# PostgreSQL Database Configuration
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Works directly with local PostgreSQL, Neon.tech, Supabase, Railway, etc.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/examportal

# Alternatively, configure individually:
# PGUSER=postgres
# PGPASSWORD=postgres
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=examportal
